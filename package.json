{
  "name": "clipboard-history",
  "version": "0.1.0",
  "description": "Lightweight clipboard history manager for macOS (Electron + TypeScript)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p electron && tsc -p renderer && cp renderer/index.html renderer/style.css dist/renderer/",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.5.2"
  },
  "build": {
    "appId": "com.clipboardhistory.app",
    "productName": "Clipboard History",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "!assets/src/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    }
  }
}
